+    def _schedule_rebuild(self) -> None:
+        # Coalesce bursts of device-added/removed signals into a single rebuild
+        # on the next main loop iteration. A continuous LE scan emits these
+        # continuously, and rebuilding once per signal made the applet do the
+        # full (previously O(devices) synchronous dbus) work many times a second.
+        if self.__rebuild_source is None:
+            self.__rebuild_source = GLib.idle_add(self.__rebuild_idle)
+
+    def __rebuild_idle(self) -> bool:
+        self.__rebuild_source = None
         self._rebuild()
