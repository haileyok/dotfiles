                 self._on_object_added(self._object_manager, obj_proxy)
 
+    @staticmethod
+    def _device_path(adapter_path: str, address: str) -> str:
+        # bluez derives device object paths deterministically from the address.
+        return f"{adapter_path.rstrip('/')}/dev_{address.upper().replace(':', '_')}"
+
     def find_device(self, address: str, adapter_path: str = "/") -> Optional[Device]:
+        # Resolve the object directly instead of scanning every device on the
+        # bus. The linear scan compared `device['Address']` for every object
+        # bluez knows about; with a continuous LE scan filling the tree with
+        # random advertisers that is thousands of property reads per call, and
+        # RecentConns calls this once per remembered device on every
+        # device-created signal.
+        if adapter_path != "/":
+            obj = self._object_manager.get_object(self._device_path(adapter_path, address))
+            if obj is not None and obj.get_interface('org.bluez.Device1') is not None:
+                return Device(obj_path=obj.get_object_path())
+
         for device in self.get_devices(adapter_path):
-            if device['Address'] == address:
+            if device['Address'].upper() == address.upper():
                 return device
         return None
 
