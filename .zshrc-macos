# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

export EDITOR=nvim

plugins=(
    git
)

# Set-up FZF key bindings (CTRL R for fuzzy history finder)
source <(fzf --zsh)

source /opt/homebrew/share/zsh-autocomplete/zsh-autocomplete.plugin.zsh
source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

bindkey '^f' autosuggest-accept

# Check archlinux plugin commands here
# https://github.com/ohmyzsh/ohmyzsh/tree/master/plugins/archlinux

# Display Pokemon-colorscripts
# Project page: https://gitlab.com/phoneybadger/pokemon-colorscripts#on-other-distros-and-macos
pokemon-colorscripts --no-title -s -r

# fastfetch. Will be disabled if above colorscript was chosen to install
#fastfetch -c $HOME/.config/fastfetch/config-compact.jsonc

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory

alias gco='git checkout'
alias gc='git commit -m'
alias gca='git commit -am'
alias gcurr='git rev-parse HEAD'
alias gcurrcp='git rev-parse HEAD | pbcopy'
alias gpr='gh pr create'
alias gs='git status'
alias gd='git pull'
alias diff='git diff'
alias ga='git add'
alias gd='git pull'
alias gp='git push'

alias ghwc='watch -n 3 gh pr checks'
alias ghc='gh pr checks'
alias ghco='gh pr checkout'
alias codes='ykman oath accounts code'

alias n=nvim

alias ylq='yarn lint --quiet'

alias sag='eval `ssh-agent -s` && ssh-add'

alias pubip='curl ipv4.icanhazip.com'

alias lsl='ls -l'

alias cat='bat'

export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvm
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"

LC_ADDRESS=en_US.UTF-8
LC_NAME=en_US.UTF-8
LC_MONETARY=en_US.UTF-8
LC_PAPER=en_US.UTF-8
LC_IDENTIFICATION=en_US.UTF-8
LC_TELEPHONE=en_US.UTF-8
LC_MEASUREMENT=en_US.UTF-8
LC_TIME=en_US.UTF-8
LC_NUMERIC=en_US.UTF-8
export LC_ALL=en_US.UTF-8

export ANDROID_HOME=$HOME/Android/Sdk
export PATH=$PATH:$ANDROID_HOME/tools

export PATH="/opt/homebrew/opt/rustup/bin:$PATH"
export PATH="/opt/homebrew/opt/go@1.25/bin:$PATH"

export PATH="/Users/haileyelizabeth/discord/discord/.local/bin:$PATH"
#compdef clyde
_clyde() {
  eval "$(_CLYDE_COMPLETE=zsh_source clyde)"
}
if [[ "$(basename -- ${(%):-%x})" != "_clyde" ]]; then
  compdef _clyde clyde
fi

source /Users/haileyelizabeth/.nix-profile/etc/profile.d/nix.sh


eval "$(starship init zsh)"

. "$HOME/.local/bin/env"
