{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 5,

    "modules-left": ["memory", "temperature", "sway/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/voice-backend", "custom/voice-type", "wireplumber", "battery", "backlight", "custom/power-profile", "tray"],

    "sway/workspaces": {
        "format-icons": {
            "active": "\uf444",
            "default": "\uf4c3"
        },
        "icon-size": 10,
        "sort-by-number": true
    },

    "clock": {
        "format": "{:%d.%m.%Y | %H:%M}"
    },

    "wireplumber": {
        "format": "\udb81\udd7e  {volume}%",
        "max-volume": 100,
        "scroll-step": 5
    },

    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "format": "{icon}  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    },

    "backlight": {
        "format": "\udb80\udcdf  {percent}%"
    },

    "memory": {
        "interval": 30,
        "format": "\uf4bc  {used:0.1f}G"
    },

    "temperature": {
        "format": "  {temperatureC}°C"
    },

    "sway/language": {
        "format": "{short}"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 16
    },

    "custom/voice-backend": {
        // Refreshed via SIGRTMIN+10 when the backend is picked; the slow poll
        // only catches Auto flipping between AC and battery.
        "exec": "python3 /home/hailey/dotfiles/bin/voice-type.py --backend-waybar",
        "return-type": "json",
        "format": "{text}",
        "interval": 30,
        "signal": 10,
        "on-click": "python3 /home/hailey/dotfiles/bin/voice-type.py --pick-backend",
        "tooltip": true
    },

    "custom/voice-type": {
        // voice-type.py sends SIGRTMIN+9 on every status change (and once more
        // after done/error expires). The 30 s poll is only a safety net for a
        // recorder that dies without updating status. Was interval 1, which
        // spawned python3 every second (~9% of a core) even when idle.
        "exec": "python3 /home/hailey/dotfiles/bin/voice-type.py --waybar",
        "return-type": "json",
        "format": "{text}",
        "interval": 30,
        "signal": 9,
        "hide-empty-text": true,
        "tooltip": true
    },

    "custom/power-profile": {
        // bin/ scripts are only on PATH via .zshrc, which waybar (launched by
        // sway) never sources — use the absolute path. ~/ expands fine under
        // waybar's /bin/sh -c invocation.
        // Same shape as custom/voice-backend: JSON status + wofi picker.
        // Every profile change made through power-profiles.sh / gamemode-hook.sh
        // sends SIGRTMIN+8, so the poll only catches changes made elsewhere.
        "exec": "~/dotfiles/bin/power-profiles.sh waybar",
        "return-type": "json",
        "format": "{text}",
        "interval": 30,
        "signal": 8,
        "on-click": "~/dotfiles/bin/power-profiles.sh pick",
        "tooltip": true
    }
}
