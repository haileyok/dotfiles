timeout 30 'pgrep -x hyprlock && swaymsg "output * dpms off"' resume 'pgrep -x hyprlock && swaymsg "output * dpms on"'
timeout 600 'pidof hyprlock || hyprlock &' resume ''
timeout 900 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"'
before-sleep 'pidof hyprlock || hyprlock &'
after-resume 'swaymsg "output * dpms on"'
